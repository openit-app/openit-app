.vite

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files — blanket-ignore all .env variants so contributors
# can't accidentally commit credentials (.env, .env.production, etc.).
.env*
!.env.development.example


# Claude Code worktrees — machine-local, never committed
.claude/worktrees/

# Ephemeral runtime state from the autonomous-dev /loop driver.
# Machine-specific (session id, pid, start time); commits cause noise
# and merge conflicts.
.claude/scheduled_tasks.lock

# Test configuration with real credentials
test-config.json
