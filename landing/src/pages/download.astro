---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestRelease } from "../lib/release.ts";

const release = await getLatestRelease();
const githubUrl = "https://github.com/openit-app/openit-app";
---
<BaseLayout title="Download OpenIT">
  <h1>Download OpenIT</h1>
  <p class="lede">
    v{release.version}
    {release.releaseUrl && (
      <>
        &middot; <a href={release.releaseUrl}>release notes</a>
      </>
    )}
  </p>

  <div id="download-sections">
    <section id="macos-section">
      <h2>macOS</h2>
      <div class="cta-row">
        <a
          class="btn"
          href={release.arm64DmgUrl ?? "#"}
          aria-disabled={release.arm64DmgUrl ? "false" : "true"}
        >
          Apple Silicon
        </a>
        <a
          class="btn secondary"
          href={release.x64DmgUrl ?? "#"}
          aria-disabled={release.x64DmgUrl ? "false" : "true"}
        >
          Intel
        </a>
      </div>

      <p>
        Open the DMG, drag <strong>OpenIT.app</strong> into <strong>/Applications</strong>,
        and launch. On first launch, macOS may show a Gatekeeper prompt — open
        <strong>System Settings &rarr; Privacy &amp; Security</strong> and click
        "Open Anyway" next to OpenIT.
      </p>
    </section>

    <section id="windows-section">
      <h2>Windows</h2>
      <div class="cta-row">
        <a
          class="btn"
          href={release.winExeUrl ?? "#"}
          aria-disabled={release.winExeUrl ? "false" : "true"}
        >
          Download Installer
        </a>
      </div>

      <p>
        Download and run the installer. Windows may show a SmartScreen prompt —
        click <strong>More info</strong>, then <strong>Run anyway</strong>.
      </p>
    </section>
  </div>

  <h2>Updates</h2>
  <p>
    OpenIT checks for updates on launch and offers to install them in-place. You
    don't need to come back to this page — the first install is the only manual
    step.
  </p>
</BaseLayout>

<script>
  const ua = navigator.userAgent.toLowerCase();
  const container = document.getElementById("download-sections");
  const macSection = document.getElementById("macos-section");
  const winSection = document.getElementById("windows-section");
  if (container && macSection && winSection) {
    if (ua.includes("win")) {
      container.insertBefore(winSection, macSection);
    }
  }
</script>
