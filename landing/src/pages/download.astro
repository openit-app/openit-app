---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestRelease } from "../lib/release.ts";

const release = await getLatestRelease();
const githubUrl = "https://github.com/openit-app/openit-app";
---
<BaseLayout title="Download OpenIT">
  <h1>Download OpenIT</h1>
  <p class="lede">
    v{release.version}
    {release.releaseUrl && (
      <>
        &middot; <a href={release.releaseUrl}>release notes</a>
      </>
    )}
  </p>

  <h2>macOS</h2>
  <div class="cta-row">
    <a
      class="btn"
      href={release.arm64DmgUrl ?? "#"}
      aria-disabled={release.arm64DmgUrl ? "false" : "true"}
    >
      {release.arm64DmgUrl ? "Apple Silicon" : "Apple Silicon — coming soon"}
      <span class="sub">M1, M2, M3, M4</span>
    </a>
    <a
      class="btn secondary"
      href={release.x64DmgUrl ?? "#"}
      aria-disabled={release.x64DmgUrl ? "false" : "true"}
    >
      {release.x64DmgUrl ? "Intel Mac" : "Intel — coming soon"}
      <span class="sub">x86_64</span>
    </a>
  </div>

  <p>
    <a href="https://support.apple.com/en-us/HT211814">Not sure which Mac you have?</a>
  </p>

  <p>
    Open the DMG, drag <strong>OpenIT.app</strong> into <strong>/Applications</strong>,
    and launch. On first launch, macOS may show a Gatekeeper prompt — open
    <strong>System Settings &rarr; Privacy &amp; Security</strong> and click
    "Open Anyway" next to OpenIT.
  </p>

  <h2>Linux &amp; Windows</h2>
  <p>
    Pre-built binaries coming soon. OpenIT is built on Tauri, which supports
    all three platforms — you can build from source today:
  </p>
  <pre><code>git clone {githubUrl}.git
cd openit-app
npm install
npm run tauri:build</code></pre>
  <p>
    Requires Node.js &ge; 20 and Rust (stable). See the
    <a href={`${githubUrl}#build-from-source`}>README</a> for full instructions.
    <a href={`${githubUrl}/issues`}>Open an issue</a> if you hit problems.
  </p>

  <h2>Updates</h2>
  <p>
    OpenIT checks for updates on launch and offers to install them in-place. You
    don't need to come back to this page — the first install is the only manual
    step.
  </p>
</BaseLayout>
