---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestRelease } from "../lib/release.ts";

const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const githubUrl = "https://github.com/openit-app/openit-app";
const releasesUrl = `${githubUrl}/releases`;
const release = await getLatestRelease();

const steps: { k: string; v: string }[] = [
  { k: "Ask", v: "Tell OpenIT what you need." },
  { k: "It does the work", v: "Claude does it and writes down how." },
  { k: "Reuse", v: "Next time, anyone just asks." },
];
---
<BaseLayout title="OpenIT · A shared workspace that runs on Claude Code" bare={true}>
  <div>
    {/* HERO */}
    <section class="mx-auto max-w-6xl px-6 pb-16 pt-12 md:px-10 md:pb-24 md:pt-20">
      <p class="hero-rise flex items-center gap-2 font-mono-tag text-[11px] text-ink/55">
        <span class="h-1.5 w-1.5 rounded-full bg-terracotta"></span>
        Open source · Runs on Claude Code · macOS &amp; Windows
      </p>

      <h1 class="hero-rise hero-rise-2 font-display mt-7 max-w-[15ch] text-[12vw] leading-[0.95] md:mt-9 md:text-[68px] lg:text-[88px]">
        Your team should only
        <span class="block text-terracotta">figure it out once.</span>
      </h1>

      <p class="hero-rise hero-rise-3 mt-7 max-w-xl text-xl leading-snug text-ink/75 md:text-2xl">
        A shared workspace your team runs by chatting in plain English. It does the work <span class="font-serif-italic text-terracotta">and remembers how.</span>
      </p>

      <div id="download" class="hero-rise hero-rise-4 mt-9 flex flex-wrap items-center gap-3">
        <a id="hero-download" href={release.releaseUrl ?? releasesUrl} class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-cream transition hover:bg-terracotta no-underline">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span class="font-medium" id="hero-download-label">Download</span>
        </a>
        <a href={githubUrl} class="group inline-flex items-center gap-2 rounded-full border border-ink/20 px-7 py-4 text-ink transition hover:border-ink hover:bg-ink hover:text-cream no-underline">
          <span class="font-medium">View on GitHub</span>
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
      </div>
      {release.available && (
        <p class="mt-4 font-mono-tag text-[11px] text-ink/40">
          v{release.version}
        </p>
      )}

      <figure class="hero-rise hero-rise-4 mt-14 md:mt-16">
        <img
          src={url("/app-hero.webp")}
          width="1432"
          height="952"
          alt="The OpenIT desktop app: a shared vault of knowledge, commands and files on the left, a one-click command list in the middle, and Claude Code built in on the right."
          class="block w-full rounded-2xl border border-ink/15 shadow-[0_40px_90px_-40px_rgba(30,20,15,0.45)]"
          loading="eager"
          decoding="async"
        />
      </figure>
    </section>

    {/* HOW IT WORKS */}
    <section class="border-t border-ink/10 bg-cream-deep">
      <div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-28">
        <div class="grid gap-10 md:grid-cols-3 md:gap-12">
          {steps.map(({ k, v }, i) => (
            <div>
              <div class="font-display text-3xl leading-none text-terracotta md:text-4xl">0{i + 1}</div>
              <div class="mt-4 font-mono-tag text-[10px] text-ink/45">{k}</div>
              <p class="mt-2 text-lg leading-snug text-ink md:text-xl">{v}</p>
            </div>
          ))}
        </div>
        <p class="mt-16 max-w-2xl text-lg leading-relaxed text-ink/70">
          Everything lives as plain files: knowledge, commands, tasks, files, and reports, in a folder you already sync. No vendor database. <span class="font-serif-italic text-terracotta">Yours to keep.</span>
        </p>
      </div>
    </section>

    {/* CLOSE */}
    <section id="status" class="border-t border-ink/10 bg-terracotta text-cream">
      <div class="mx-auto max-w-6xl px-6 py-20 md:px-10 md:py-32">
        <h2 class="font-display text-6xl leading-[0.95] md:text-8xl">
          Open <span class="font-serif-italic">source.</span>
        </h2>
        <p class="mt-7 max-w-xl text-lg leading-snug text-cream/85 md:text-xl">
          Apache 2.0. macOS and Windows today, Linux next. Free to download, fork, and make your own.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a id="bottom-download" href={release.releaseUrl ?? releasesUrl} class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-cream transition hover:bg-cream hover:text-ink no-underline">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            <span class="font-medium" id="bottom-download-label">Download</span>
          </a>
          <a href={githubUrl} class="inline-flex items-center gap-2 rounded-full border border-cream/30 px-7 py-4 text-cream transition hover:bg-cream hover:text-ink no-underline">
            <span class="font-medium">View on GitHub</span>
          </a>
        </div>
        {release.available && (
          <p class="mt-4 font-mono-tag text-[11px] text-cream/60">
            v{release.version}
          </p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ arm64DmgUrl: release.arm64DmgUrl, x64DmgUrl: release.x64DmgUrl, winExeUrl: release.winExeUrl }}>
  const ua = navigator.userAgent.toLowerCase();
  let url, label;
  if (ua.includes("win")) {
    url = winExeUrl;
    label = "Download for Windows";
  } else if (ua.includes("mac")) {
    url = arm64DmgUrl;
    label = "Download for macOS";
  } else {
    url = null;
    label = "Download";
  }
  for (const id of ["hero-download", "bottom-download"]) {
    const el = document.getElementById(id);
    if (el && url) el.setAttribute("href", url);
  }
  for (const id of ["hero-download-label", "bottom-download-label"]) {
    const el = document.getElementById(id);
    if (el && label) el.textContent = label;
  }
</script>
