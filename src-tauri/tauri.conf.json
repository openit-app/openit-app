{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenIT",
  "version": "1.1.5",
  "identifier": "ai.pinkfish.openit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenIT",
        "width": 1320,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 640,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/openit-plugin/manifest.json": "openit-plugin/manifest.json",
      "../scripts/openit-plugin/CLAUDE.md": "openit-plugin/CLAUDE.md",
      "../scripts/openit-plugin/skills/*.md": "openit-plugin/skills/",
      "../scripts/openit-plugin/schemas/*.json": "openit-plugin/schemas/",
      "../scripts/openit-plugin/agents/*.md": "openit-plugin/agents/",
      "../scripts/openit-plugin/scripts/*.mjs": "openit-plugin/scripts/",
      "../scripts/openit-plugin/scripts/*.cjs": "openit-plugin/scripts/",
      "../scripts/openit-plugin/scripts/*.yml": "openit-plugin/scripts/",
      "../scripts/openit-plugin/seed/tickets/*.json": "openit-plugin/seed/tickets/",
      "../scripts/openit-plugin/seed/people/*.json": "openit-plugin/seed/people/",
      "../scripts/openit-plugin/seed/knowledge/*.md": "openit-plugin/seed/knowledge/",
      "../scripts/openit-plugin/seed/conversations/sample-ticket-1/*.json": "openit-plugin/seed/conversations/sample-ticket-1/",
      "../scripts/openit-plugin/seed/conversations/sample-ticket-2/*.json": "openit-plugin/seed/conversations/sample-ticket-2/",
      "../scripts/openit-plugin/seed/conversations/sample-ticket-3/*.json": "openit-plugin/seed/conversations/sample-ticket-3/",
      "../scripts/openit-plugin/seed/conversations/sample-ticket-4/*.json": "openit-plugin/seed/conversations/sample-ticket-4/",
      "../scripts/openit-plugin/seed/conversations/sample-ticket-5/*.json": "openit-plugin/seed/conversations/sample-ticket-5/",
      "../scripts/openit-plugin/seed/reports/*.md": "openit-plugin/seed/reports/",
      "../scripts/openit-plugin/seed/access/*.json": "openit-plugin/seed/access/",
      "../scripts/openit-plugin/seed/assets/*.json": "openit-plugin/seed/assets/",
      "../scripts/openit-plugin/seed/skills/*.md": "openit-plugin/seed/skills/",
      "../scripts/openit-plugin/seed/scripts/*.mjs": "openit-plugin/seed/scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "OpenIT \u2014 Claude-powered IT operations for SMBs.",
    "longDescription": "OpenIT is a desktop app for IT admins that wraps Claude Code in a native shell with a file explorer, viewer, and tools catalog. Answer once, automate forever.",
    "copyright": "Copyright \u00a9 2025-2026 OpenIT Contributors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQkY2Q0RBQjIxNjY3QQpSV1I2WmlHcnpmYXJDYjVDTUJVMWtaR3lZMXlIUThDaHpEcnIyeXRVdzRBSTVoczVUTFpBQ3N2ago=",
      "endpoints": [
        "https://github.com/openit-app/openit-app/releases/latest/download/latest.json"
      ]
    }
  }
}
