{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenIT",
  "version": "3.2.0",
  "identifier": "ai.pinkfish.openit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenIT",
        "width": 1320,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 640,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../scripts/openit-plugin/manifest.json": "openit-plugin/manifest.json",
      "../scripts/openit-plugin/CLAUDE.md": "openit-plugin/CLAUDE.md",
      "../scripts/openit-plugin/instructions/*.md": "openit-plugin/instructions/",
      "../scripts/openit-plugin/commands/*.md": "openit-plugin/commands/",
      "../scripts/openit-plugin/schemas/*.json": "openit-plugin/schemas/",
      "../scripts/openit-plugin/scripts/*.mjs": "openit-plugin/scripts/",
      "../scripts/openit-plugin/seed/people/*.json": "openit-plugin/seed/people/",
      "../scripts/openit-plugin/seed/knowledge/*.md": "openit-plugin/seed/knowledge/",
      "../scripts/openit-plugin/seed/reports/*.md": "openit-plugin/seed/reports/",
      "../scripts/openit-plugin/seed/access/*.json": "openit-plugin/seed/access/",
      "../scripts/openit-plugin/seed/assets/*.json": "openit-plugin/seed/assets/",
      "../scripts/openit-plugin/seed/commands/*.md": "openit-plugin/seed/commands/",
      "../scripts/openit-plugin/seed/scripts/*.mjs": "openit-plugin/seed/scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "OpenIT \u2014 a shared, file-based workspace for small teams, powered by Claude Code.",
    "longDescription": "OpenIT is a desktop app that wraps Claude Code in a native shell around a shared, file-based vault. Small teams share knowledge, reports, commands, and files \u2014 and assign each other tasks \u2014 all as plain files they own. Answer once, reuse forever.",
    "copyright": "Copyright \u00a9 2025-2026 OpenIT Contributors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQkY2Q0RBQjIxNjY3QQpSV1I2WmlHcnpmYXJDYjVDTUJVMWtaR3lZMXlIUThDaHpEcnIyeXRVdzRBSTVoczVUTFpBQ3N2ago=",
      "endpoints": [
        "https://github.com/openit-app/openit-app/releases/latest/download/latest.json"
      ]
    }
  }
}
