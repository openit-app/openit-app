{
  "schemaVersion": "2026-05-07",
  "name": "openit-access",
  "type": "datastore",
  "isStructured": true,
  "description": "Access matrix — who has access to which systems. Each row links a person to a system with their current access level and status.",
  "fields": [
    {
      "id": "employee",
      "label": "Employee",
      "type": "string",
      "required": true,
      "comment": "Full name of the person."
    },
    {
      "id": "email",
      "label": "Email",
      "type": "string",
      "required": true
    },
    {
      "id": "system",
      "label": "System",
      "type": "string",
      "required": true,
      "comment": "Name of the system (Slack, Salesforce, GitHub, AWS, etc.)."
    },
    {
      "id": "accessLevel",
      "label": "Access level",
      "type": "string",
      "required": true,
      "comment": "Role or permission level (admin, member, viewer, owner, etc.)."
    },
    {
      "id": "status",
      "label": "Status",
      "type": "string",
      "required": true,
      "comment": "'active', 'suspended', or 'revoked'."
    },
    {
      "id": "grantedAt",
      "label": "Granted",
      "type": "date",
      "nullable": true,
      "comment": "When access was granted."
    },
    {
      "id": "notes",
      "label": "Notes",
      "type": "text",
      "nullable": true
    }
  ]
}
